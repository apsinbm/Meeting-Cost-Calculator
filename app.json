{
  "expo": {
    "name": "Meeting Cost Calculator",
    "slug": "meeting-cost-calculator",
    "version": "1.0.33",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Track the real cost of your meetings. Calculate accurate meeting expenses by combining employee salaries, bonuses, and comprehensive employment costs including Bermuda payroll taxes, social insurance, and health insurance. See in real-time how much each meeting costs and generate detailed cost reports.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aps.meetingcostcalculator",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "mailto"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.aps.meetingcostcalculator",
      "permissions": [
        "READ_CALENDAR",
        "POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      ["expo-calendar", {
        "calendarPermission": "This app reads your calendar to calculate meeting costs and match attendees."
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "03f2d98d-ed24-40a2-ab7c-b7a762f85716"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}
